# IAM + FGAC Commerce Demo — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# The full public URL of this application (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# PING IDENTITY — OIDC / PKCE
#
# Setup:
#   1. Log in to PingOne Developer: https://developer.pingidentity.com
#   2. Create an Application → OIDC Web App
#   3. Set Redirect URI to: ${NEXT_PUBLIC_APP_URL}/api/auth/callback
#   4. Enable PKCE (S256), set Grant Type to "Authorization Code"
#   5. Copy values below from the Application settings
# ─────────────────────────────────────────────────────────────────────────────

# Your PingOne environment's OIDC issuer (e.g. https://auth.pingone.com/{envId}/as)
PING_ISSUER=https://auth.pingone.com/YOUR_ENVIRONMENT_ID/as

# OAuth Client ID (from PingOne Application settings)
PING_CLIENT_ID=YOUR_PING_CLIENT_ID

# OAuth Client Secret (only required for server-side token exchange)
PING_CLIENT_SECRET=YOUR_PING_CLIENT_SECRET

# Registered redirect URI — must match what is registered in PingOne exactly
PING_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Space-separated list of OAuth scopes to request
PING_SCOPES=openid profile email

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL MOCK IDP — Enterprise Login (username/password)
#
# Replaces the (non-functional) Ping Identity OIDC login above for the
# "Enterprise Login" option. Authenticates against a local in-memory
# directory of 50 demo users imported from dynamouser.csv
# (lib/auth/dynamoUsers.ts → lib/auth/mockIdp.ts, identity fields only —
# entitlements are seeded separately into lib/crm/mockData.ts, keyed by the
# same userId). Issues a signed JWT (sub=userId) that PingAuthorize/Permit
# use as the subject identity when resolving entitlements.
#
# Demo credentials for ALL 50 imported users: username is "firstname.lastname"
# (e.g. "christopher.roy", derived from dynamouser.csv), password is
# MOCK_IDP_DEMO_PASSWORD below.
# ─────────────────────────────────────────────────────────────────────────────

# HMAC secret used to sign/verify mock-IDP JWTs. MUST be set to a random
# value outside of local development — never commit the real value.
MOCK_IDP_JWT_SECRET=change-me-to-a-long-random-string

# JWT "iss" claim
MOCK_IDP_ISSUER=local-mock-idp

# JWT "aud" claim — should match whatever PingAuthorize is configured to expect
MOCK_IDP_AUDIENCE=pingauthorize-poc

# Shared demo password for all 50 mock-IDP users (demo credential only)
MOCK_IDP_DEMO_PASSWORD="demo-only-change-me"

# ─────────────────────────────────────────────────────────────────────────────
# DYNAMODB — Entitlement store for the 50 local-mock-IDP users
#
# The 50 mock-IDP users' Sold-To accounts / role / tool grants are resolved
# from DynamoDB (never duplicated into Supabase or lib/crm/mockData.ts).
# Miguel/Sarah/Carlos (legacy demo users) are unaffected and keep using
# Supabase/mockData exactly as before.
#
# Tables share the "ccex-poc-ping-" prefix:
# accounts, applications, sold-to, tools, user-accounts, user-applications,
# user-sold-to, user-tool-access, users. Sold-To accounts are
# derived from `sold_to` joined via `user_sold_to` — the separate
# `accounts` table is intentionally NOT used. See
# lib/crm/dynamoEntitlementService.ts for the exact item shapes.
# ─────────────────────────────────────────────────────────────────────────────

# AWS region of the DynamoDB tables
DYNAMODB_REGION=us-east-1

# Set true in CCEX so every OIDC user is resolved from these DynamoDB tables.
# Leave false locally to keep the legacy Supabase/mock demo users.
DYNAMODB_ENTITLEMENTS_ENABLED=false

# Shared prefix for the CCEX users, Sold-To, tool, account, and application tables
DYNAMODB_TABLE_PREFIX=ccex-poc-ping-

# Optional — only for DynamoDB Local / a custom endpoint. Leave unset for real AWS.
DYNAMODB_ENDPOINT=

# Optional — omit to use the default AWS credential provider chain (e.g. an IAM role)
DYNAMODB_ACCESS_KEY_ID=
DYNAMODB_SECRET_ACCESS_KEY=
DYNAMODB_SESSION_TOKEN=
# aws_session_token is also recognized for compatibility with the current local env.

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
#
# Setup:
#   1. Create a project at https://supabase.com/dashboard
#   2. Go to Settings → API
#   3. Run supabase/migrations/001_initial.sql in the SQL Editor
#   4. Run supabase/seed.sql for demo data
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase service role key (server-side only — bypasses RLS)
# NEVER expose this in the browser or commit it to source control
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY

# ─────────────────────────────────────────────────────────────────────────────
# COVEO / PINGAUTHORIZE COMMERCE ENDPOINTS
#
# The access token and Honeywell user ID are taken from the authenticated
# server session; do not add them to this file or expose them to the browser.
# Defaults below match the attached Postman collection and may be overridden.
# ─────────────────────────────────────────────────────────────────────────────

COVEO_SEARCH_URL=https://devapi.portal.honeywell.com/pingauthorize/rest/ping/search/v2
COVEO_ORDER_HEADER_URL=https://devapi.portal.honeywell.com/pingauthorize/v1/order-header-details
COVEO_ORDER_LINEITEM_URL=https://devapi.portal.honeywell.com/pingauthorize/v1/order-lineitem-details
COVEO_APP_ID=a7wnc51036b9
COVEO_CLIENT_ID=d7f8a163-5d30-45da-9387-791bfb4eaba3
COVEO_TRACKING_ID=ba-qa
COVEO_HON_ORG_ID=HBT
COVEO_SAP_CLIENT=900
COVEO_SAP_SOURCE=BRP
COVEO_LANGUAGE_CODE=en

# Optional local-only portal token (same token used by Bruno/Postman).
# Keep the token secret. honId comes from the signed-in DynamoDB profile.
# The portal must authorize this token for that user and selected Sold-To.
# Leave blank when using a real portal OIDC session. Disabled in production.
COVEO_VALIDATED_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# PERMIT.IO — FINE-GRAINED AUTHORIZATION
#
# Setup:
#   1. Sign up at https://app.permit.io
#   2. Create a project and copy the API key from Settings → API Keys
#   3. Import policies from permit/policies/ using the Permit CLI or dashboard
#   4. (Optional) Run a local PDP: docker run -p 7766:7000 permitio/pdp-v2
# ─────────────────────────────────────────────────────────────────────────────

# Permit.io SDK API key (from Settings → API Keys → Secret Key)
PERMIT_API_KEY=permit_key_YOUR_API_KEY

# Permit.io PDP URL
# - Local Docker PDP: http://localhost:7766
# - Permit cloud PDP (no Docker needed): https://cloudpdp.api.permit.io
PERMIT_PDP_URL=https://cloudpdp.api.permit.io

# ─────────────────────────────────────────────────────────────────────────────
# PINGAUTHORIZE — FINE-GRAINED AUTHORIZATION (alternate provider)
#
# This app supports switching between Permit.io and PingAuthorize as the
# active authorization engine (see lib/authorization/providerFactory.ts and
# the Admin Console → Provider tab). If PING_PAP_URL/PING_PDP_URL are left
# unset, the PingAuthorize provider runs in a local in-memory "demo mode"
# (see services/ping-authorize/demoStore.ts) so the feature is fully
# testable without a real PingAuthorize deployment.
#
# NOTE: these are unrelated to PING_ISSUER/PING_CLIENT_ID above, which
# configure Ping Identity OIDC login (authentication, not authorization).
#
# Setup (if you have a real PingAuthorize PAP/PDP deployment):
#   1. Set PING_PAP_URL to your Policy Administration Point (Policy Manager) base URL
#   2. Set PING_PDP_URL to your Policy Decision Point base URL
#   3. Set PING_USER_ID to a valid PAP user id — this is the real, confirmed
#      auth mode (sent as an `x-user-id` header) that PingAuthorize's Policy
#      Manager REST API actually uses; PING_USERNAME/PING_PASSWORD (HTTP
#      Basic) is only a fallback for LDAP-backed tenants.
#   4. Set PING_BRANCH_ID to the branch (ID or name) to operate on — required
#      by nearly every Policy Manager endpoint (PolicySets/Policies/Rules).
# ─────────────────────────────────────────────────────────────────────────────

# Which provider is active by default (admins can override at runtime via the
# Admin Console). One of: "permit" | "ping". Defaults to "permit" if unset.
AUTH_PROVIDER=permit

# PingAuthorize Policy Administration Point (Policy Editor) base URL
PING_PAP_URL=

# PingAuthorize Policy Decision Point base URL
PING_PDP_URL=

# Real, confirmed-working auth mode for Policy Manager calls (x-user-id
# header). Takes precedence over PING_USERNAME/PING_PASSWORD below.
PING_USER_ID=

# Branch (ID or name) that Policy Manager CRUD operates against.
PING_BRANCH_ID=

# HTTP Basic Auth credentials for the PingAuthorize PAP/PDP APIs (LDAP-backed
# tenants only — fallback if PING_USER_ID is not set).
PING_USERNAME=
PING_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────────────────────────────────────

# Secret used to sign session cookies (min 32 chars, generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
