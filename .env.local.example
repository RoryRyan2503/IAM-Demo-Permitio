# IAM + FGAC Commerce Demo — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# The full public URL of this application (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# PING IDENTITY — OIDC / PKCE
#
# Setup:
#   1. Log in to PingOne Developer: https://developer.pingidentity.com
#   2. Create an Application → OIDC Web App
#   3. Set Redirect URI to: ${NEXT_PUBLIC_APP_URL}/api/auth/callback
#   4. Enable PKCE (S256), set Grant Type to "Authorization Code"
#   5. Copy values below from the Application settings
# ─────────────────────────────────────────────────────────────────────────────

# Your PingOne environment's OIDC issuer (e.g. https://auth.pingone.com/{envId}/as)
PING_ISSUER=https://auth.pingone.com/YOUR_ENVIRONMENT_ID/as

# OAuth Client ID (from PingOne Application settings)
PING_CLIENT_ID=YOUR_PING_CLIENT_ID

# OAuth Client Secret (only required for server-side token exchange)
PING_CLIENT_SECRET=YOUR_PING_CLIENT_SECRET

# Registered redirect URI — must match what is registered in PingOne exactly
PING_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Space-separated list of OAuth scopes to request
PING_SCOPES=openid profile email

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
#
# Setup:
#   1. Create a project at https://supabase.com/dashboard
#   2. Go to Settings → API
#   3. Run supabase/migrations/001_initial.sql in the SQL Editor
#   4. Run supabase/seed.sql for demo data
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase service role key (server-side only — bypasses RLS)
# NEVER expose this in the browser or commit it to source control
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY

# ─────────────────────────────────────────────────────────────────────────────
# PERMIT.IO — FINE-GRAINED AUTHORIZATION
#
# Setup:
#   1. Sign up at https://app.permit.io
#   2. Create a project and copy the API key from Settings → API Keys
#   3. Import policies from permit/policies/ using the Permit CLI or dashboard
#   4. (Optional) Run a local PDP: docker run -p 7766:7000 permitio/pdp-v2
# ─────────────────────────────────────────────────────────────────────────────

# Permit.io SDK API key (from Settings → API Keys → Secret Key)
PERMIT_API_KEY=permit_key_YOUR_API_KEY

# Permit.io PDP URL
# - Local Docker PDP: http://localhost:7766
# - Permit cloud PDP (no Docker needed): https://cloudpdp.api.permit.io
PERMIT_PDP_URL=https://cloudpdp.api.permit.io

# ─────────────────────────────────────────────────────────────────────────────
# PINGAUTHORIZE — FINE-GRAINED AUTHORIZATION (alternate provider)
#
# This app supports switching between Permit.io and PingAuthorize as the
# active authorization engine (see lib/authorization/providerFactory.ts and
# the Admin Console → Provider tab). If PING_PAP_URL/PING_PDP_URL are left
# unset, the PingAuthorize provider runs in a local in-memory "demo mode"
# (see services/ping-authorize/demoStore.ts) so the feature is fully
# testable without a real PingAuthorize deployment.
#
# NOTE: these are unrelated to PING_ISSUER/PING_CLIENT_ID above, which
# configure Ping Identity OIDC login (authentication, not authorization).
#
# Setup (if you have a real PingAuthorize PAP/PDP deployment):
#   1. Set PING_PAP_URL to your Policy Administration Point (Policy Manager) base URL
#   2. Set PING_PDP_URL to your Policy Decision Point base URL
#   3. Set PING_USER_ID to a valid PAP user id — this is the real, confirmed
#      auth mode (sent as an `x-user-id` header) that PingAuthorize's Policy
#      Manager REST API actually uses; PING_USERNAME/PING_PASSWORD (HTTP
#      Basic) is only a fallback for LDAP-backed tenants.
#   4. Set PING_BRANCH_ID to the branch (ID or name) to operate on — required
#      by nearly every Policy Manager endpoint (PolicySets/Policies/Rules).
# ─────────────────────────────────────────────────────────────────────────────

# Which provider is active by default (admins can override at runtime via the
# Admin Console). One of: "permit" | "ping". Defaults to "permit" if unset.
AUTH_PROVIDER=permit

# PingAuthorize Policy Administration Point (Policy Editor) base URL
PING_PAP_URL=

# PingAuthorize Policy Decision Point base URL
PING_PDP_URL=

# Real, confirmed-working auth mode for Policy Manager calls (x-user-id
# header). Takes precedence over PING_USERNAME/PING_PASSWORD below.
PING_USER_ID=

# Branch (ID or name) that Policy Manager CRUD operates against.
PING_BRANCH_ID=

# HTTP Basic Auth credentials for the PingAuthorize PAP/PDP APIs (LDAP-backed
# tenants only — fallback if PING_USER_ID is not set).
PING_USERNAME=
PING_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────────────────────────────────────

# Secret used to sign session cookies (min 32 chars, generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
